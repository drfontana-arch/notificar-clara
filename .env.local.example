# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── WhatsApp Business (BSP) ────────────────────────────────
# Token de verificación del webhook (inventalo vos, tiene que coincidir
# con lo que configurás en el dashboard del BSP)
WHATSAPP_VERIFY_TOKEN=tu_token_secreto_aqui

# ── Resend (email de alertas a empleados) ──────────────────
# Crear cuenta gratis en https://resend.com → API Keys → Create API Key
# Plan gratis: 100 emails/día, 3000/mes — suficiente para el piloto
# FROM por defecto: onboarding@resend.dev (no requiere dominio verificado)
# Para producción: verificar dominio en Resend y configurar RESEND_FROM
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=NotificAR Clara <notificaciones@tu-dominio.gob.ar>
